# Stage Finder -- environment configuration template
#
# Copy to .env if you need local overrides for development.
#
# HARD RULE: no secrets ever go in this file. API keys, OAuth tokens and
# other credentials live exclusively in the OS keychain (see ADR 0002 and
# docs/PRODUCT.md). The per-launch session token is generated in memory by
# the Tauri core and is never written to disk.

# Backend bind address. Must remain 127.0.0.1 (ADR 0001); do not change.
# STAGE_FINDER_HOST=127.0.0.1

# Backend port for running the sidecar manually (python -m app) during
# development. The desktop app itself always picks a random free port.
# STAGE_FINDER_PORT=8000

# Backend log level: critical|error|warning|info|debug|trace.
# STAGE_FINDER_LOG_LEVEL=info
